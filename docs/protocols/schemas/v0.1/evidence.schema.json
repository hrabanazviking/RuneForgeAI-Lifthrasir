{"$id":"https://lifthrasir.local/schemas/v0.1/evidence.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"allOf":[{"if":{"properties":{"kind":{"const":"differential-run"}},"required":["kind"]},"then":{"properties":{"tool_versions":{"minProperties":1}},"required":["baseline_evidence_id","tool_versions"]}},{"if":{"properties":{"kind":{"enum":["test-run","negative-control"]}},"required":["kind"]},"then":{"properties":{"tool_versions":{"minProperties":1}},"required":["tool_versions"]}}],"description":"An evidence record for the Mimir append-only, hash-linked evidence store (ADR-0002 message ownership: observation and evidence events are produced by lifthrasir-sensor / Heimdall; verification and journal evidence is produced on the broker path). Binary payloads are stored separately; this record carries only a content digest and references (research/25 design principles). Schema version 0.1 (LIF-0004).","properties":{"artifact_refs":{"items":{"minLength":1,"type":"string"},"type":"array","uniqueItems":true},"baseline_evidence_id":{"pattern":"^ev-[a-z0-9][a-z0-9-]*$","type":"string"},"content_digest":{"pattern":"^sha256:[a-f0-9]{64}$","type":"string"},"evidence_id":{"pattern":"^ev-[a-z0-9][a-z0-9-]*$","type":"string"},"evidence_status":{"enum":["idea","hypothesis","reproducer","lab-verified","cross-platform-verified","human-reviewed","deployed-with-monitoring","upstream-submitted","upstream-accepted"],"type":"string"},"hypothesis_id":{"pattern":"^hyp-[a-z0-9][a-z0-9-]*$","type":"string"},"incident_id":{"pattern":"^inc-[a-z0-9][a-z0-9-]*$","type":"string"},"kind":{"enum":["observation","log-excerpt","metric-snapshot","test-run","differential-run","negative-control","artifact","document"],"type":"string"},"limitations":{"items":{"type":"string"},"type":"array"},"plan_id":{"pattern":"^plan-[a-z0-9][a-z0-9-]*$","type":"string"},"recorded_at":{"format":"date-time","type":"string"},"schema":{"const":"lifthrasir.evidence.v0.1"},"sc