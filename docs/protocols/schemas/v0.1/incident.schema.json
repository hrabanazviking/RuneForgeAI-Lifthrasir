{"$id":"https://lifthrasir.local/schemas/v0.1/incident.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"allOf":[{"if":{"properties":{"status":{"enum":["resolved","closed"]}},"required":["status"]},"then":{"required":["resolved_at"]}},{"if":{"properties":{"status":{"enum":["open","investigating"]}},"required":["status"]},"then":{"not":{"required":["resolved_at"]}}}],"description":"An incident record, owned (produced) solely by the correlator within the observation plane (ADR-0002 message ownership). Derived only from evidence events; carries evidence references, never authority. Schema version 0.1 (LIF-0004).","properties":{"created_at":{"format":"date-time","type":"string"},"evidence_refs":{"items":{"pattern":"^ev-[a-z0-9][a-z0-9-]*$","type":"string"},"minItems":1,"type":"array","uniqueItems":true},"host":{"additionalProperties":false,"properties":{"boot_id":{"minLength":1,"type":"string"},"host_local_id":{"minLength":1,"type":"string"}},"required":["host_local_id","boot_id"],"type":"object"},"incident_id":{"pattern":"^inc-[a-z0-9][a-z0-9-]*$","type":"string"},"known_unknowns":{"items":{"type":"string"},"type":"array"},"observed_at":{"format":"date-time","type":"string"},"resolved_at":{"format":"date-time","type":"string"},"schema":{"const":"lifthrasir.incident.v0.1"},"schema_version":{"const":"0.1"},"severity":{"enum":["info","low","medium","high","critical"],"type":"string"},"status":{"enum":["open","investigating","resolved","closed"],"type":"string"},"summary":{"minLength":1,"type":"string"},"symptoms":{"items":{"minLength":1,"type":"string"},"minItems":1,"type":"array"},"triggering_event_ids":{"items":{"pattern":"^ev-[a-z0-9][a-z0-9-]*$","type":"string"},"type":"array","uniqueItems":true}},"required":["schema","schema_version","incident_id","status","severity","summary","host","observed_at","created_at","symptoms","evidence_refs"],"title":"Lifthrasir Incident Record v0.1","type":"object"}