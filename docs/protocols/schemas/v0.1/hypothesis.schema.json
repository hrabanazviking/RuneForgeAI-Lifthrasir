{"$id":"https://lifthrasir.local/schemas/v0.1/hypothesis.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"allOf":[{"if":{"properties":{"status":{"const":"supported"}},"required":["status"]},"then":{"properties":{"evidence_for":{"minItems":1}},"required":["evidence_for"]}},{"if":{"properties":{"status":{"const":"refuted"}},"required":["status"]},"then":{"properties":{"evidence_against":{"minItems":1}},"required":["evidence_against"]}}],"description":"A causal hypothesis, owned (produced) solely by Replicater and its bounded subagents (ADR-0002 message ownership). A claim with supporting and contradicting evidence and uncertainty; confers no permission. Schema version 0.1 (LIF-0004).","properties":{"claim":{"minLength":1,"type":"string"},"confidence":{"maximum":1,"minimum":0,"type":"number"},"created_at":{"format":"date-time","type":"string"},"evidence_against":{"items":{"pattern":"^ev-[a-z0-9][a-z0-9-]*$","type":"string"},"type":"array","uniqueItems":true},"evidence_for":{"items":{"pattern":"^ev-[a-z0-9][a-z0-9-]*$","type":"string"},"type":"array","uniqueItems":true},"evidence_status":{"enum":["idea","hypothesis","reproducer","lab-verified","cross-platform-verified","human-reviewed","deployed-with-monitoring","upstream-submitted","upstream-accepted"],"type":"string"},"hypothesis_id":{"pattern":"^hyp-[a-z0-9][a-z0-9-]*$","type":"string"},"incident_id":{"pattern":"^inc-[a-z0-9][a-z0-9-]*$","type":"string"},"schema":{"const":"lifthrasir.hypothesis.v0.1"},"schema_version":{"const":"0.1"},"status":{"enum":["proposed","supported","refuted","inconclusive"],"type":"string"},"test_plan":{"minLength":1,"type":"string"},"updated_at":{"format":"date-time","type":"string"}},"required":["schema","schema_version","hypothesis_id","incident_id","claim","status","confidence","evidence_for","evidence_against","test_plan","evidence_status","created_at"],"title":"Lifthrasir Hypothesis Record v0.1","type":"object"}